{
  "name": "staysync",
  "version": "1.0.0",
  "description": "Hotel Offer Orchestrator - Aggregates hotel offers from multiple suppliers",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev": "ts-node src/server.ts",
    "worker": "ts-node src/temporal/worker.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/client": "^1.9.0",
    "@temporalio/worker": "^1.9.0",
    "@temporalio/workflow": "^1.9.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "axios": "^1.6.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "@types/ioredis": "^5.0.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  }
}
